acc1 <- mean(cluster == z)
acc2 <- mean(cluster != z)
return(max(acc1, acc2))
}
# === Print accuracies for this scenario ===
cat("Scenario: n1 =", n1, ", n2 =", n2, "\n")
cat("K-means accuracy :", round(clustering_accuracy(km_cluster,  z)*100, 2), "%\n")
cat("GMM     accuracy :", round(clustering_accuracy(gmm_cluster, z)*100, 2), "%\n")
# === Confusion tables ===
cat("\nK-means confusion table:\n")
print(table(KMeans = km_cluster, True = z))
cat("\nGMM confusion table:\n")
print(table(GMM = gmm_cluster, True = z))
# === Plots: 4-panel comparison ===
# (panel layout style from 3.3 class notes)
par(mfrow = c(2, 2), mar = c(4, 4, 3, 1))
# Panel 1: True labels
plot(V_hat, col = z, pch = 19, cex = 0.6,
main = "True Community Labels",
xlab = "Eigenvector 1", ylab = "Eigenvector 2")
legend("topright",
legend = c(paste0("Community 1 (n1=",n1,")"),
paste0("Community 2 (n2=",n2,")")),
col = c(1, 2), pch = 19, cex = 0.7)
# Panel 2: K-means clustering
plot(V_hat, col = km_cluster, pch = 19, cex = 0.6,
main = paste0("K-means Clusters\n(Accuracy: ",
round(clustering_accuracy(km_cluster, z)*100, 1), "%)"),
xlab = "Eigenvector 1", ylab = "Eigenvector 2")
legend("topright",
legend = c("Cluster 1", "Cluster 2"),
col = c(1, 2), pch = 19, cex = 0.7)
# Panel 3: GMM clustering
plot(V_hat, col = gmm_cluster, pch = 19, cex = 0.6,
main = paste0("GMM Clusters\n(Accuracy: ",
round(clustering_accuracy(gmm_cluster, z)*100, 1), "%)"),
xlab = "Eigenvector 1", ylab = "Eigenvector 2")
legend("topright",
legend = c("Cluster 1", "Cluster 2"),
col = c(1, 2), pch = 19, cex = 0.7)
# Panel 4: Where do K-means and GMM DISAGREE?
# Highlight nodes where the two methods give different labels
disagree <- (km_cluster != gmm_cluster)
# Some nodes may match due to label switching — correct for that
if(mean(disagree) > 0.5) disagree <- !disagree
plot(V_hat,
col = ifelse(disagree, "red", "gray70"),
pch = ifelse(disagree, 17, 19),   # triangles = disagreement
cex = ifelse(disagree, 0.9, 0.5),
main = paste0("Disagreement Between Methods\n(",
sum(disagree), " nodes differ)"),
xlab = "Eigenvector 1", ylab = "Eigenvector 2")
legend("topright",
legend = c("Agree", "Disagree"),
col = c("gray70", "red"),
pch = c(19, 17), cex = 0.7)
## Reset plot layout
par(mfrow = c(1,1))
